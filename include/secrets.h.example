#pragma once

// Copy this file to secrets.h (gitignored -- never commit real credentials)
// and fill in your own values.

#define HA_BASE_URL "http://homeassistant.local:8123"

// Generate a token in Home Assistant:
// Profile (bottom left) > Security > Long-Lived Access Tokens > Create Token
#define HA_TOKEN "PASTE_YOUR_LONG_LIVED_ACCESS_TOKEN_HERE"

// Wireless (OTA) firmware updates over the local network -- pick any
// hostname/password. Upload with:
//   OTA_PASSWORD=<your password> pio run -e esp32dev_ota -t upload
#define OTA_HOSTNAME "epaper-remoment"
#define OTA_PASSWORD "PASTE_YOUR_OWN_OTA_PASSWORD_HERE"
